# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/
*.Rproj

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Mac system files
.DS_Store


/.quarto/
**/*.quarto_ipynb

# Quarto book build output
/_book/

# Per-chapter output from single-file `quarto render <chapter>.qmd` (full-book
# renders go to /_book/ instead; these are the standalone-render equivalent)
[0-9][0-9]-*/*_files/

# R session temp dumps
.RDataTmp*

/.luarc.json

# Compiled Fortran shared libraries (rebuilt by scripts/build-fortran.sh pre-render)
**/*.so

# Quarto per-chapter execution cache (regenerated locally)
/_freeze/

# Single-language practice copies generated in place by scripts/make-lang-variants.py
# (setup step, not part of the book render; see README)
[0-9][0-9]-*/*-R.qmd
[0-9][0-9]-*/*-py.qmd

# NOTE: recipe-index-generated.qmd is deliberately NOT ignored. It is generated by
# scripts/make-recipe-index.py, but appendix-recipe-index.qmd pulls it in with
# {{< include >}}, and Quarto expands includes while building the book config, before
# pre-render scripts run. Ignoring it broke `quarto render` on a clean clone.

# Python bytecode cache
__pycache__/

# recipe-eval is archived to recipe-eval.tar.gz (not tracked)
recipe-eval/
recipe-eval.tar.gz
